# Copy file này thành keystore.properties (cùng thư mục) rồi điền thông tin thật.
# keystore.properties và file .jks đã nằm trong .gitignore: TUYỆT ĐỐI không commit.
# Mất file .jks hoặc mật khẩu thì không cập nhật được app trên Google Play nữa → hãy sao lưu.
storeFile=../lifequest-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
